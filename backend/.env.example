# JWT
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Persistence mode (memory|file|prisma)
# For local development with PostgreSQL database, use: prisma
DOG_REPO=prisma
ADDRESS_REPO=prisma
ORDER_REPO=prisma
RECIPE_REPO=prisma

# Prisma/Postgres connection (required when any *_REPO=prisma)
# Example: postgres://user:password@localhost:5432/sevenkitchen
DATABASE_URL=
