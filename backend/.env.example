# ===========================================
# SevenKitchen Backend - Environment Template
# ===========================================
# 复制此文件为 .env.development (本地开发) 或 .env.production (生产环境)
# cp .env.example .env.development

# Server Port
PORT=3001

# Database connection string
# 开发环境: postgresql://postgres:postgres@localhost:5432/sevenkitchen_dev
# 生产环境: 请使用实际的数据库连接信息
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sevenkitchen?timezone=Asia/Shanghai"

# Repository mode switches
DOG_REPO=prisma
ADDRESS_REPO=prisma
ORDER_REPO=prisma
RECIPE_REPO=prisma

# JWT Configuration
# 生产环境请使用强密钥！可用: openssl rand -base64 32
JWT_SECRET=dev-jwt-secret-key-not-for-production
JWT_EXPIRES_IN=7d

# WeChat Mini Program Configuration
# 开发环境使用测试号，生产环境使用正式 AppID
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# Optional local-only WeChat mock login.
# WECHAT_FORCE_MOCK=true
# WECHAT_MOCK_OPENID=mock_openid_local_admin
# WECHAT_MOCK_UNIONID=mock_unionid_local_admin

# Tencent COS Configuration (Optional)
# COS_SECRET_ID=your_cos_secret_id
# COS_SECRET_KEY=your_cos_secret_key
# COS_BUCKET=your_cos_bucket
# COS_REGION=ap-chengdu
# COS_CDN_DOMAIN=your-cdn-domain.com

# Tencent Cloud OCR for miniapp supplement label recognition (Optional)
# If omitted, the backend will reuse COS_SECRET_ID/COS_SECRET_KEY.
# The configured Tencent Cloud account must have OCR permission enabled.
# TENCENTCLOUD_SECRET_ID=your_tencent_cloud_secret_id
# TENCENTCLOUD_SECRET_KEY=your_tencent_cloud_secret_key
# TENCENT_OCR_REGION=ap-guangzhou

# DeepSeek Agent settings encryption (Recommended for production)
# Used to encrypt API keys saved through the admin Agent settings page.
# AGENT_CONFIG_ENCRYPTION_KEY=replace_with_a_long_random_secret

# Legacy OpenAI review provider (Optional)
# Leave empty when using the admin-configured DeepSeek Agent.
# NUTRITION_CANDIDATE_REVIEW_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_NUTRITION_REVIEW_MODEL=gpt-4o-mini
