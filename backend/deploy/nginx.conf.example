# Nginx configuration for SevenKitchen Backend
# Copy this file to /etc/nginx/sites-available/sevenkitchen
# Then create a symlink: sudo ln -s /etc/nginx/sites-available/sevenkitchen /etc/nginx/sites-enabled/

# Upstream backend server
upstream sevenkitchen_backend {
    server 127.0.0.1:3000;
    keepalive 64;
}

# HTTP server (redirect to HTTPS in production)
server {
    listen 80;
    listen [::]:80;
    server_name _;  # Replace with your domain name, e.g., api.example.com

    # For health checks and initial setup, allow HTTP
    # In production, uncomment the redirect below to force HTTPS
    # return 301 https://$server_name$request_uri;

    # Health check endpoint (can be accessed via HTTP)
    location /api/v1/health {
        proxy_pass http://sevenkitchen_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Health check specific settings
        access_log off;
    }

    # API endpoints
    location /api/ {
        proxy_pass http://sevenkitchen_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Swagger documentation
    location /api/docs {
        proxy_pass http://sevenkitchen_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Default location
    location / {
        return 404;
    }
}

