{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "npm run prisma:generate:build",
    "prisma:generate:build": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/sevenkitchen} prisma generate",
    "build": "nest build && node copy-fonts.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:dev:miniapp": "PORT=${PORT:-3011} DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/sevenkitchen} NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main",
    "start:once": "ts-node -r tsconfig-paths/register scripts/start-once.ts",
    "start:check": "ts-node -r tsconfig-paths/register scripts/start-check.ts",
    "start:check:miniapp": "PORT=${PORT:-3011} DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/sevenkitchen} NODE_ENV=development npm run start:check",
    "seed:fediaf-2025-dog-standard": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/sevenkitchen} ts-node -r tsconfig-paths/register prisma/seed-fediaf-2025-dog-standards.ts",
    "backfill:breed-aliases": "ts-node -r tsconfig-paths/register prisma/backfill-breed-aliases.ts",
    "backfill:breed-aliases:apply": "ts-node -r tsconfig-paths/register prisma/backfill-breed-aliases.ts --apply",
    "backfill:ingredient-nutrition-profile-v2": "ts-node -r tsconfig-paths/register prisma/backfill-ingredient-nutrition-profile-v2.ts",
    "backfill:ingredient-nutrition-profile-v2:apply": "ts-node -r tsconfig-paths/register prisma/backfill-ingredient-nutrition-profile-v2.ts --apply",
    "backfill:nutrition-food-display-names": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/sevenkitchen} ts-node -r tsconfig-paths/register prisma/backfill-nutrition-food-display-names.ts",
    "backfill:nutrition-food-display-names:apply": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/sevenkitchen} ts-node -r tsconfig-paths/register prisma/backfill-nutrition-food-display-names.ts --apply",
    "backfill:procurement-sku-defaults": "ts-node -r tsconfig-paths/register prisma/backfill-procurement-sku-defaults.ts",
    "backfill:procurement-sku-defaults:apply": "ts-node -r tsconfig-paths/register prisma/backfill-procurement-sku-defaults.ts --apply",
    "backfill:supplement-packaging-single-layer": "ts-node -r tsconfig-paths/register prisma/backfill-supplement-packaging-single-layer.ts",
    "backfill:supplement-packaging-single-layer:apply": "ts-node -r tsconfig-paths/register prisma/backfill-supplement-packaging-single-layer.ts --apply",
    "backfill:recipe-supplement-alternatives": "ts-node -r tsconfig-paths/register prisma/backfill-recipe-supplement-alternatives.ts",
    "backfill:recipe-supplement-alternatives:apply": "ts-node -r tsconfig-paths/register prisma/backfill-recipe-supplement-alternatives.ts --apply",
    "backfill:recipe-supplement-targets-v2": "ts-node -r tsconfig-paths/register prisma/backfill-recipe-supplement-targets-v2.ts",
    "backfill:recipe-supplement-targets-v2:apply": "ts-node -r tsconfig-paths/register prisma/backfill-recipe-supplement-targets-v2.ts --apply",
    "audit:missing-supplement-concentrations": "ts-node -r tsconfig-paths/register scripts/audit-missing-supplement-concentrations.ts",
    "audit:fediaf-2025-dog-standard": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/sevenkitchen} ts-node -r tsconfig-paths/register scripts/audit-fediaf-2025-dog-standard.ts",
    "audit:recipe-stats": "ts-node scripts/audit-recipe-stats.ts",
    "repair:favorite-counts": "ts-node scripts/repair-favorite-counts.ts",
    "repair:local-recipe-designer-schema": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/sevenkitchen} prisma db execute --schema prisma/schema.prisma --file prisma/local-repairs/recipe-designer-schema.sql",
    "smoke:pricing-purchase": "node scripts/smoke_pricing_purchase_flow.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "verify:orders": "bash ./scripts/phase_orders_closed_loop_verify.sh",
    "verify:recipe": "bash ./scripts/assert_public_recipe.sh",
    "env:dev": "cp .env.development .env && echo 'Switched to development environment'",
    "env:prod": "cp .env.production .env && echo 'Switched to production environment'"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.3",
    "@prisma/client": "^6.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.4",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "canvas": "^3.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.17.2",
    "prisma": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^11.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js",
      "json",
      "ts",
      "d.ts"
    ],
    "rootDir": ".",
    "testRegex": "tests/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.{t,j}?(x|j|<rootDir>/src/$1)"
    ],
    "moduleNameMapper": {
      "^src/auth\\.controller$": "<rootDir>/src/interfaces/controllers/auth.controller",
      "^src/addresses\\.controller$": "<rootDir>/src/interfaces/controllers/addresses.controller",
      "^src/dogs\\.controller$": "<rootDir>/src/interfaces/controllers/dogs.controller",
      "^src/orders\\.controller$": "<rootDir>/src/interfaces/controllers/orders.controller",
      "^src/recipes\\.controller$": "<rootDir>/src/interfaces/controllers/recipes.controller",
      "^src/staff-kitchen\\.controller$": "<rootDir>/src/interfaces/controllers/staff-kitchen.controller",
      "^src/staff-shipping\\.controller$": "<rootDir>/src/interfaces/controllers/staff-shipping.controller",
      "^src/controllers/(.*)$": "<rootDir>/src/interfaces/controllers/$1",
      "^src/shipping-fulfillment\\.service$": "<rootDir>/src/application/shipping/shipping-fulfillment.service",
      "^src/inventory\\.service$": "<rootDir>/src/application/inventory/inventory.service",
      "^src/order\\.service$": "<rootDir>/src/application/order/order.service",
      "^src/production\\.service$": "<rootDir>/src/application/production/production.service",
      "^src/kitchen\\.service$": "<rootDir>/src/application/kitchen/kitchen.service",
      "^src/address/(.*)$": "<rootDir>/src/application/address/$1",
      "^src/auth/(.*)$": "<rootDir>/src/interfaces/auth/$1",
      "^src/common/(.*)$": "<rootDir>/src/interfaces/common/$1",
      "^src/config/(.*)$": "<rootDir>/src/application/config/$1",
      "^src/dog/(.*)$": "<rootDir>/src/application/dog/$1",
      "^src/ingredient/(.*)$": "<rootDir>/src/application/ingredient/$1",
      "^src/inventory/(.*)$": "<rootDir>/src/application/inventory/$1",
      "^src/order/(.*)$": "<rootDir>/src/application/order/$1",
      "^src/production/(.*)$": "<rootDir>/src/application/production/$1",
      "^src/shipping/(.*)$": "<rootDir>/src/application/shipping/$1",
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
