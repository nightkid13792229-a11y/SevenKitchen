generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id                           String                      @id @default(uuid()) @map("id")
  orderNo                      String?                     @unique @map("order_no") @db.VarChar(20)
  customerId                   String                      @map("customer_id")
  status                       OrderStatus
  type                         OrderType
  targetProductionDate         DateTime?                   @map("target_production_date")
  amountProduct                Decimal                     @map("amount_product")
  amountShipping               Decimal                     @map("amount_shipping")
  amountTotal                  Decimal                     @map("amount_total")
  /// 本单使用的「定制费抵扣」金额（元）。
  ///
  /// 口径：**已含在（净）amount_product 里**，不参与任何算术 ——
  /// 记录它只是为了展示"这单抵了多少"与审计，订单金额校验规则保持
  /// `amount_total = amount_product + amount_shipping` 不变。
  creditAmountApplied          Decimal                     @default(0) @map("credit_amount_applied") @db.Decimal(10, 2)
  /// 抵扣来源的定制订单（CustomRecipeOrder.id）。
  /// 刻意**不加唯一约束**：额度支持余额结转，同一张定制单可以抵多张成品单。
  customRecipeCreditOrderId    String?                     @map("custom_recipe_credit_order_id")
  totalAmount                  Decimal?                    @map("total_amount")
  pricingBreakdownSnapshot     Json?                       @map("pricing_breakdown_snapshot")
  shippingAddressSnapshot      Json?                       @map("shipping_address_snapshot")
  addressId                    String?                     @map("address_id")
  dogId                        String?                     @map("dog_id")
  cancelledAt                  DateTime?                   @map("cancelled_at")
  cancellationReason           String?                     @map("cancellation_reason")
  cancelledBy                  String?                     @map("cancelled_by")
  paymentMethod                String?                     @map("payment_method")
  transactionId                String?                     @map("transaction_id")
  paidAt                       DateTime?                   @map("paid_at")
  paymentStatus                String?                     @map("payment_status")
  adminRemark                  String?                     @map("admin_remark")
  trackingNumber               String?                     @map("tracking_number")
  carrierCode                  String?                     @map("carrier_code")
  shippedAt                    DateTime?                   @map("shipped_at")
  completedAt                  DateTime?                   @map("completed_at")
  createdAt                    DateTime                    @default(now()) @map("created_at")
  aftersaleType                AftersaleType?              @map("aftersale_type")
  freezingSince                DateTime?                   @map("freezing_since")
  aftersaleSince               DateTime?                   @map("aftersale_since")
  aftersaleReason              String?                     @map("aftersale_reason")
  aftersalePhotos              String[]                    @default([]) @map("aftersale_photos")
  originalTargetProductionDate DateTime?                   @map("original_target_production_date") @db.Timestamp(6)
  address                      Address?                    @relation(fields: [addressId], references: [id])
  customer                     User                        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dog                          Dog?                        @relation(fields: [dogId], references: [id])
  items                        OrderItem[]
  statusHistory                OrderStatusHistory[]
  costSettlements              OrderCostSettlement[]
  settlementAdjustments        OrderSettlementAdjustment[]
  refundRecords                OrderRefundRecord[]

  photoShareTokens PhotoShareToken[]

  /// 本单是"某张订单的重做"：指向原单；为空表示这是一张正常订单。
  /// @unique 保证一张原单最多被重做一次（数据库级防重复）。
  remakeFromOrderId            String?                     @unique @map("remake_from_order_id")
  remakeFromOrder              Order?                      @relation("OrderRemake", fields: [remakeFromOrderId], references: [id], onDelete: SetNull)
  /// 原单反向指向它的重做单
  remakeOrder                  Order?                      @relation("OrderRemake")

  @@index([customerId])
  @@index([status])
  @@index([aftersaleType])
  @@index([remakeFromOrderId])
  @@map("order")
}

// 订单友好短号当日自增序列（SK + YYYYMMDD + -NNN）
model OrderSequence {
  dateKey String @id @map("date_key") @db.VarChar(8)
  lastSeq Int    @map("last_seq") @default(0)

  @@map("order_sequence")
}

model OrderStatusHistory {
  id         String      @id @default(uuid()) @map("id")
  orderId    String      @map("order_id")
  timestamp  DateTime    @default(now()) @map("timestamp")
  actor      String      @map("actor")
  actorId    String?     @map("actor_id")
  metadata   Json?       @map("metadata")
  fromStatus OrderStatus @map("from_status")
  toStatus   OrderStatus @map("to_status")
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderId, timestamp])
  @@map("order_status_history")
}

model PhotoShareToken {
  id        String   @id @default(uuid()) @map("id")
  orderId   String   @map("order_id")
  token     String   @unique @map("token") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  createdBy String   @map("created_by")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([orderId])
  @@index([expiresAt])
  @@map("photo_share_token")
}

model OrderShippingNotification {
  id                 String                                      @id @default(uuid()) @map("id")
  orderId            String                                      @unique @map("order_id")
  customerId         String                                      @map("customer_id")
  templateId         String?                                     @map("template_id") @db.VarChar(120)
  subscriptionStatus OrderShippingNotificationSubscriptionStatus @default(PENDING) @map("subscription_status")
  subscribedAt       DateTime?                                   @map("subscribed_at")
  declinedAt         DateTime?                                   @map("declined_at")
  lastPromptedAt     DateTime?                                   @map("last_prompted_at")
  sendStatus         OrderShippingNotificationSendStatus         @default(NOT_SENT) @map("send_status")
  sentAt             DateTime?                                   @map("sent_at")
  msgid              String?                                     @map("msgid") @db.VarChar(120)
  errorMessage       String?                                     @map("error_message")
  createdAt          DateTime                                    @default(now()) @map("created_at")
  updatedAt          DateTime                                    @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([subscriptionStatus])
  @@index([sendStatus])
  @@map("order_shipping_notification")
}

model RecipeShareToken {
  id        String   @id @default(uuid()) @map("id")
  recipeId  String   @map("recipe_id")
  token     String   @unique @map("token") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  createdBy String   @map("created_by")
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([recipeId])
  @@index([expiresAt])
  @@map("recipe_share_token")
}

model OrderItem {
  id                   String    @id @default(uuid()) @map("id")
  orderId              String    @map("order_id")
  recipeSnapshot       Json      @map("recipe_snapshot")
  quantityG            Float     @map("quantity_g")
  packageCount         Int       @map("package_count")
  packageSpecG         Int       @map("package_spec_g")
  packagePlan          Json?     @map("package_plan")
  ingredientSourcePlan String?   @map("ingredient_source_plan") @db.VarChar(40)
  customRequirements   String?   @map("custom_requirements")
  dailyIntakeG         Float?    @map("daily_intake_g")
  allocatedAt          DateTime? @map("allocated_at")
  productionBatchId    String?   @map("production_batch_id")
  /// 试吃装商品 ID（鲜食订单为 null）。便于按商品统计销量
  tastingPackId        String?   @map("tasting_pack_id")
  cookingMethod        String?   @map("cooking_method") @db.VarChar(20)
  preparationMethod    String?   @map("preparation_method") @db.VarChar(20)
  dogId                String?   @map("dog_id")
  vacuumBagSpec        String?   @map("vacuum_bag_spec") @db.VarChar(20)
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([dogId])
  @@index([productionBatchId])
  @@index([tastingPackId])
  @@map("order_item")
}

model User {
  id                      String               @id @default(uuid()) @map("id")
  phone                   String?              @unique @map("phone") @db.VarChar(20)
  wechatOpenid            String?              @unique @map("wechat_openid") @db.VarChar(100)
  nickname                String?              @map("nickname") @db.VarChar(100)
  role                    UserRole             @default(CUSTOMER) @map("role")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  avatarUrl               String?              @map("avatar_url")
  lastLoginAt             DateTime?            @map("last_login_at")
  status                  UserStatus           @default(ACTIVE) @map("status")
  wechatUnionid           String?              @unique @map("wechat_unionid") @db.VarChar(100)
  password                String?              @map("password") @db.VarChar(255)
  addresses               Address[]
  customRecipeOrders      CustomRecipeOrder[]  @relation("CustomRecipeOrderCustomer")
  diySheets               DIYSheet[]
  dogs                    Dog[]
  favoriteRecipes         FavoriteRecipe[]
  orders                  Order[]
  recipeReviews           RecipeReview[]
  createdPurchaseLists    PurchaseList[]       @relation("PurchaseListCreator")
  paidReimbursements      Reimbursement[]      @relation("ReimbursementPayer")
  reviewedReimbursements  Reimbursement[]      @relation("ReimbursementReviewer")
  submittedReimbursements Reimbursement[]      @relation("ReimbursementSubmitter")
  operatedRefundRecords   OrderRefundRecord[]  @relation("OrderRefundRecordOperator")
  feedbacks               Feedback[]
  feedbackReplies         FeedbackReply[]
  wechatIdentities        UserWechatIdentity[]
  supplementOrders        SupplementOrder[]

  @@index([wechatOpenid])
  @@index([phone])
  @@map("user")
}

model UserWechatIdentity {
  id          String   @id @default(uuid()) @map("id")
  userId      String   @map("user_id")
  appId       String   @map("app_id") @db.VarChar(80)
  openid      String   @map("openid") @db.VarChar(100)
  unionid     String?  @map("unionid") @db.VarChar(100)
  sessionKey  String?  @map("session_key") @db.VarChar(255)
  lastLoginAt DateTime @default(now()) @map("last_login_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, openid])
  @@index([userId])
  @@index([unionid])
  @@map("user_wechat_identity")
}

model AccountMigration {
  id             String                 @id @default(uuid()) @map("id")
  token          String                 @unique @map("token") @db.VarChar(80)
  sourceUserId   String                 @map("source_user_id")
  verifiedUserId String?                @map("verified_user_id")
  targetUserId   String?                @map("target_user_id")
  phone          String?                @map("phone") @db.VarChar(20)
  status         AccountMigrationStatus @default(PENDING) @map("status")
  metadata       Json?                  @map("metadata")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  expiresAt      DateTime               @map("expires_at")
  verifiedAt     DateTime?              @map("verified_at")
  confirmedAt    DateTime?              @map("confirmed_at")
  cancelledAt    DateTime?              @map("cancelled_at")

  @@index([sourceUserId, status])
  @@index([verifiedUserId])
  @@index([targetUserId])
  @@index([expiresAt])
  @@map("account_migration")
}

model DogProfileEvent {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  dogId        String?  @map("dog_id")
  eventName    String   @map("event_name")
  mode         String
  entrySource  String?  @map("entry_source")
  stepName     String?  @map("step_name")
  moduleName   String?  @map("module_name")
  hasDraft     Boolean? @map("has_draft")
  calcStatus   String?  @map("calc_status")
  submitStatus String?  @map("submit_status")
  properties   Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([eventName, createdAt])
  @@index([customerId, createdAt])
  @@index([dogId, createdAt])
  @@map("dog_profile_event")
}

/// 成品鲜食链路的转化漏斗事件
/// 与 dog_profile_event 的区别：
///   1. 允许匿名（登录前的浏览与点击也要能采集），因此 customerId 可空；
///   2. 面向整条购买链路（首页 → 详情 → 订购 → 结算 → 支付），不是单一档案流程。
/// 顾客「已知晓生命阶段与食谱不匹配、仍继续下单」的确认记录。
///
/// 为什么单独建表而不是只在前端弹个窗：
///   弹出提醒如果不留痕，将来一旦狗狗因吃错生命阶段的粮出问题，
///   我们拿不出"已经明确告知过顾客"的任何凭据。这张表就是那份凭据 ——
///   记录谁、哪只狗、哪张食谱、当时系统给出的结论是什么、什么时候从哪个页面确认的。
model LifeStageAcknowledgement {
  id              String   @id @default(uuid()) @map("id")
  customerId      String   @map("customer_id")
  dogId           String   @map("dog_id")
  recipeId        String   @map("recipe_id")
  /// 确认时后端给出的匹配结论（MANUAL_MISMATCH / FALLBACK_ADULT / FALLBACK_FIRST）
  matchType       String   @map("match_type")
  /// 确认时系统算出的狗狗生命阶段
  dogLifeStage    String?  @map("dog_life_stage")
  /// 确认时展示的食谱适用生命阶段
  recipeLifeStage String?  @map("recipe_life_stage")
  /// 从哪个页面确认的：order / diy / diy_sheet
  source          String   @map("source")
  acknowledgedAt  DateTime @default(now()) @map("acknowledged_at")

  @@index([customerId, acknowledgedAt])
  @@index([dogId, acknowledgedAt])
  @@index([recipeId, acknowledgedAt])
  @@map("life_stage_acknowledgement")
}

model ProductFunnelEvent {
  id          String   @id @default(uuid()) @map("id")
  customerId  String?  @map("customer_id")
  /// 小程序端生成的会话标识，用于把匿名阶段与登录后的行为串成一条漏斗
  sessionId   String?  @map("session_id")
  eventName   String   @map("event_name")
  /// 漏斗步骤名（如 detail_view / tap_buy / login_done），便于按顺序统计流失
  step        String?  @map("step")
  recipeId    String?  @map("recipe_id")
  dogId       String?  @map("dog_id")
  orderId     String?  @map("order_id")
  /// 进入页面时的来源，用于区分首页 / 详情 / 分享 / 客服等入口
  entrySource String?  @map("entry_source")
  properties  Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([eventName, createdAt])
  @@index([customerId, createdAt])
  @@index([sessionId, createdAt])
  @@index([recipeId, createdAt])
  @@map("product_funnel_event")
}

model Address {
  id            String  @id @default(uuid()) @map("id")
  userId        String  @map("user_id")
  recipientName String  @map("recipient_name")
  phone         String  @map("phone")
  region        Json    @map("region")
  detail        String  @map("detail")
  isDefault     Boolean @map("is_default")
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([userId])
  @@map("address")
}

model DogBreed {
  id                   String          @id @default(uuid()) @map("id")
  name                 String          @map("name")
  aliases              String[]        @default([]) @map("aliases")
  sizeCategory         DogSizeCategory @map("size_category")
  growthCurveType      GrowthCurveType @map("growth_curve_type")
  adultAgeMonths       Int             @map("adult_age_months")
  seniorAgeYears       Int             @map("senior_age_years")
  averageAdultWeightKg Float?          @map("average_adult_weight_kg")
  isCommon             Boolean         @default(false) @map("is_common")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@index([sizeCategory])
  @@index([isCommon])
  @@map("dog_breed")
}

model Dog {
  id                   String              @id @default(uuid()) @map("id")
  ownerId              String              @map("owner_id")
  name                 String              @map("name")
  breedId              String              @map("breed_id")
  birthday             DateTime            @map("birthday")
  gender               DogGender           @map("gender")
  isNeutered           Boolean             @map("is_neutered")
  currentWeightKg      Float               @map("current_weight_kg")
  bcsScore             Int                 @map("bcs_score")
  activityLevel        ActivityLevel       @map("activity_level")
  lifeStageOverride    LifeStageOverride   @map("life_stage_override")
  sizeClassOverride    DogSizeCategory?    @map("size_class_override")
  mealsPerDay          Int                 @default(2) @map("meals_per_day")
  treatInputMode       TreatInputMode      @default(ESTIMATE_LEVEL) @map("treat_input_mode")
  treatLevel           TreatLevel          @default(LOW) @map("treat_level")
  manualTreatKcal      Int?                @map("manual_treat_kcal")
  medicalHistory       String?             @map("medical_history")
  preferredFoods       String?             @map("preferred_foods")
  cachedTargetFoodKcal Int                 @default(0) @map("cached_target_food_kcal")
  createdAt            DateTime            @default(now()) @map("created_at")
  customBreedName      String?             @map("custom_breed_name")
  avatarUrl            String?             @map("avatar_url")
  allergyFoods         String?             @map("allergy_foods")
  pickyFoods           String?             @map("picky_foods")
  allergyRecords       AllergyRecord[]
  checkupRecords       CheckupRecord[]
  customRecipeOrders   CustomRecipeOrder[] @relation("CustomRecipeOrderDog")
  owner                User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  medicalRecords       MedicalRecord[]
  orders               Order[]
  vaccineRecords       VaccineRecord[]
  weightRecords        WeightRecord[]

  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@map("dog")
}

model Recipe {
  id                     String                      @id @default(uuid()) @map("id")
  recipeId               String                      @map("recipe_id")
  version                Int                         @map("version")
  name                   String                      @map("name")
  status                 RecipeStatus                @map("status")
  energyDensityKcalPerKg Float                       @map("energy_density_kcal_per_kg")
  productionLossRate     Float                       @map("production_loss_rate")
  batchLaborHours        Float?                      @map("batch_labor_hours")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  applicableLifeStages   Json                        @default("[]") @map("applicable_life_stages")
  coverImageUrl          String?                     @map("cover_image_url")
  coverTitle             String?                     @map("cover_title") @db.VarChar(20)
  description            String?                     @map("description")
  /// 一句话卖点（合规文案，由 AI 生成 + 人工确认后保存）
  sellingPoint           String?                     @map("selling_point") @db.VarChar(120)
  detailImages           Json?                       @map("detail_images")
  diyGenCount            Int                         @default(0) @map("diy_gen_count")
  favoriteCount          Int                         @default(0) @map("favorite_count")
  likeCount              Int                         @default(0) @map("like_count")
  nutritionDetailedData  Json?                       @map("nutrition_detailed_data")
  nutritionStandard      String                      @default("FEDIAF_2021") @map("nutrition_standard")
  productionSteps        String?                     @map("production_steps")
  salesCount             Int                         @default(0) @map("sales_count")
  viewCount              Int                         @default(0) @map("view_count")
  targetHealthTags       Json                        @default("[]") @map("target_health_tags")
  videoUrl               String?                     @map("video_url")
  designSource           String?                     @map("design_source")
  customOrderId          String?                     @map("custom_order_id")
  isCustomRecipe         Boolean                     @default(false) @map("is_custom_recipe")
  seriesId               String?                     @map("series_id")
  seriesLifeStage        String?                     @map("series_life_stage")
  customerOwnerId        String?                     @map("customer_owner_id")
  customerDogId          String?                     @map("customer_dog_id")
  /// 发布该配方时设计系列的参考爱犬（仅作历史记录，用于后台按爱犬搜索）
  referenceDogId         String?                     @map("reference_dog_id")
  sourceDesignRecipeId   String?                     @unique @map("source_design_recipe_id")
  customOrder            CustomRecipeOrder?          @relation("CustomRecipeOrders")
  series                 RecipeSeries?               @relation(fields: [seriesId], references: [id])
  healthTagAssignments   RecipeHealthTagAssignment[]
  items                  RecipeItem[]
  reviews                RecipeReview[]
  shareTokens            RecipeShareToken[]

  @@unique([recipeId, version])
  @@index([recipeId])
  @@index([status])
  @@index([createdAt])
  @@index([isCustomRecipe])
  @@index([seriesId])
  @@index([seriesId, seriesLifeStage, status])
  @@index([customerOwnerId])
  @@index([customerDogId])
  @@index([referenceDogId])
  @@map("recipe")
}

model RecipeSeries {
  id             String                     @id @default(uuid()) @map("id")
  name           String                     @map("name") @db.VarChar(200)
  status         RecipeSeriesStatus         @default(ACTIVE) @map("status")
  businessStatus RecipeSeriesBusinessStatus @default(DRAFT) @map("business_status")
  deletedAt      DateTime?                  @map("deleted_at")
  deletedBy      String?                    @map("deleted_by")
  createdBy      String?                    @map("created_by")
  customerDogId  String?                    @map("customer_dog_id")
  referenceDogId String?                    @map("reference_dog_id")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  recipes        Recipe[]
  designs        DesignRecipe[]
  coverBadges    RecipeSeriesCoverBadge[]

  @@index([status])
  @@index([businessStatus])
  @@index([updatedAt])
  @@index([customerDogId])
  @@index([referenceDogId])
  @@index([createdBy, status, businessStatus, updatedAt])
  @@map("recipe_series")
}

model RecipeItem {
  id                     String                        @id @default(uuid()) @map("id")
  recipeId               String                        @map("recipe_id")
  recipeVersion          Int                           @map("recipe_version")
  ingredientId           String                        @map("ingredient_id")
  nutritionFoodId        String?                       @map("nutrition_food_id")
  preparationMethod      String?                       @map("preparation_method")
  ratioPercent           Float?                        @map("ratio_percent")
  nutrientTargetKey      String?                       @map("nutrient_target_key")
  nutrientTargetValue    Float?                        @map("nutrient_target_value")
  supplementTargets      Json?                         @map("supplement_targets")
  sortOrder              Int                           @default(0) @map("sort_order")
  exampleWeight          Float?                        @map("example_weight")
  ingredient             Ingredient                    @relation(fields: [ingredientId], references: [id])
  nutritionFood          NutritionFood?                 @relation(fields: [nutritionFoodId], references: [id])
  recipe                 Recipe                        @relation(fields: [recipeId, recipeVersion], references: [recipeId, version], onDelete: Cascade)
  supplementAlternatives RecipeSupplementAlternative[]

  @@index([recipeId, recipeVersion])
  @@index([nutritionFoodId])
  @@map("recipe_item")
}

model RecipeSupplementAlternative {
  id                      String     @id @default(uuid()) @map("id")
  recipeItemId            String     @map("recipe_item_id")
  alternativeIngredientId String     @map("alternative_ingredient_id")
  sortOrder               Int        @default(0) @map("sort_order")
  isActive                Boolean    @default(true) @map("is_active")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")
  recipeItem              RecipeItem @relation(fields: [recipeItemId], references: [id], onDelete: Cascade)
  alternativeIngredient   Ingredient @relation(fields: [alternativeIngredientId], references: [id], onDelete: Restrict)

  @@unique([recipeItemId, alternativeIngredientId])
  @@index([recipeItemId])
