/// 食谱系列的封面角标（系列级，一次设置全系列生效）
///
/// 为什么单独建表、不复用 RecipeHealthTagAssignment：
///   · assignment 表达的是"这个食谱版本有哪些健康标签"（用于筛选与合规记录）；
///   · 本表表达的是"这个系列在封面角标上展示哪 1~2 个词"（用于展示）。
///   两者语义不同，混用会导致"勾了筛选标签就自动变成角标"的意外行为。
///
/// 存的是**词表引用而非文字**：这样在词表里改一次名，所有角标自动跟着变，
/// 也从结构上保证角标只能来自合规词表。
model RecipeSeriesCoverBadge {
  id          String   @id @default(uuid()) @map("id")
  seriesId    String   @map("series_id")
  healthTagId String   @map("health_tag_id")
  /// 多个角标时的展示顺序
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  series    RecipeSeries    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  healthTag RecipeHealthTag @relation(fields: [healthTagId], references: [id], onDelete: Cascade)

  @@unique([seriesId, healthTagId])
  @@index([seriesId])
  @@index([healthTagId])
  @@map("recipe_series_cover_badge")
}

