/// 食谱定制的可配置项（单例）。
///
/// 刻意与鲜食的 GlobalConfig、补剂的 SupplementShopConfig 解耦：
/// 定制是独立产品线（顶层设计 v4 产品线 ③），它的价格与产能参数
/// 不该和别的生意共用一个值，否则"调一边影响另一边"。
///
/// 关键解耦点：**定制费**与**可抵扣金额**是两个独立参数 ——
/// 顾客付多少钱、其中多少钱能抵成品货款，由业务在后台分开定。
model CustomRecipeConfig {
  id String @id @default("singleton") @map("id")

  /// 定制费（元）：顾客提交定制单时支付的金额
  feeAmount Decimal @default(300) @map("fee_amount") @db.Decimal(10, 2)

  /// 可抵扣金额（元）：定制费中可用于抵扣成品货款的额度。
  /// 不得超过定制费（后台校验）；0 表示定制费纯粹是服务费，不抵货款。
  creditAmount Decimal @default(300) @map("credit_amount") @db.Decimal(10, 2)

  /// 交付周期（工作日）：从预约日起算，遇公众假期顺延
  deliveryWorkDays Int @default(3) @map("delivery_work_days")

  /// 每日接单上限：同一天约满后不再接受新的预约
  dailyCapacity Int @default(4) @map("daily_capacity")

  /// 定制订单支付超时（分钟）；0 表示不自动关单。
  /// 与鲜食（PaymentConfig）、补剂（SupplementShopConfig）各自独立。
  paymentTimeoutMinutes Int @default(30) @map("payment_timeout_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("custom_recipe_config")
}

