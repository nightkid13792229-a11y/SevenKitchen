{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sevenkitchen.local/schemas/ingredient-import-manifest.schema.json",
  "title": "SevenKitchen Standard Ingredient Import Manifest",
  "type": "object",
  "required": [
    "version",
    "operationMode",
    "ingredient",
    "operatorConfirmation"
  ],
  "properties": {
    "version": { "const": 1 },
    "operationMode": {
      "enum": ["local-draft", "production-package"]
    },
    "updateExistingIngredientId": { "type": "string" },
    "ingredient": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": { "enum": ["FOOD", "SUPPLEMENT"] },
        "name": { "type": "string", "minLength": 1 },
        "brand": { "type": ["string", "null"] },
        "productModel": { "type": ["string", "null"] },
        "tagIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "procurementSkus": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": true
    },
    "nutritionProfiles": {
      "type": "array",
      "items": { "type": "object" }
    },
    "sourceCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "sourceName",
          "source",
          "stateTags",
          "essentialCoveragePercent"
        ],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "sourceName": { "type": "string", "minLength": 1 },
          "source": {
            "enum": [
              "USDA_FDC",
              "NZFCD",
              "NEVO",
              "MEXT",
              "AFCD",
              "AUSNUT",
              "CNF",
              "COFID",
              "CIQUAL",
              "CFCT"
            ]
          },
          "matchedName": { "type": "string" },
          "stateTags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "raw",
                "cooked",
                "dried",
                "peeled",
                "unpeeled",
                "oil",
                "powder",
                "prepared"
              ]
            }
          },
          "essentialCoveragePercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    },
    "sourceSearchLog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "status",
          "query",
          "searchedAt",
          "evidenceUri",
          "notes"
        ],
        "properties": {
          "source": {
            "enum": [
              "USDA_FDC",
              "NZFCD",
              "NEVO",
              "MEXT",
              "AFCD",
              "AUSNUT",
              "CNF",
              "COFID",
              "CIQUAL",
              "CFCT"
            ]
          },
          "status": {
            "enum": [
              "searched_no_match",
              "state_mismatch",
              "coverage_too_low",
              "source_unavailable",
              "candidate_found"
            ]
          },
          "query": { "type": "string", "minLength": 1 },
          "searchedAt": { "type": "string", "format": "date-time" },
          "evidenceUri": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "packageEvidence": {
      "type": "object",
      "properties": {
        "packageImages": {
          "type": "array",
          "items": { "type": "object" }
        },
        "labelSources": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": true
    },
    "supplementLabel": {
      "type": "object",
      "additionalProperties": true
    },
    "dbAlignmentReport": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string" }
      },
      "additionalProperties": true
    },
    "operatorConfirmation": {
      "type": "object",
      "properties": {
        "localWriteApproved": { "type": "boolean" },
        "productionPackageApproved": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
